{#
 # Fréquentation en temps réel (cadre « matomo-reporting-live », rechargé par la page). Variables : counters
 # (LiveCounters ou null si indisponible), minutes, live_frame.
 #}
<turbo-frame id="{{ live_frame }}">
    {% block live %}
        {% if counters %}
            <p>En ce moment ({{ minutes }} dernières minutes) : {{ counters.visits|matomo_number }} visite{{ counters.visits > 1 ? 's' }}, {{ counters.actions|matomo_number }} action{{ counters.actions > 1 ? 's' }}. Lu à {{ counters.readAt|date('H:i', false) }}.</p>
        {% else %}
            <p>Fréquentation en temps réel indisponible.</p>
        {% endif %}
    {% endblock %}
</turbo-frame>
